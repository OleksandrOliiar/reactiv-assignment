# Configuration service (apps/api)
PORT=3001
DATABASE_URL=postgres://reactiv:reactiv@localhost:5432/reactiv
API_KEY=change-me-to-a-long-random-secret
LOG_LEVEL=info
NODE_ENV=development

# Web app (apps/web). These are read only by the React Router server.
CONFIG_SERVICE_URL=http://localhost:3001
CONFIG_SERVICE_API_KEY=change-me-to-a-long-random-secret
DEFAULT_CONFIG_ID=default
