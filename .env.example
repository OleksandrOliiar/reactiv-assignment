# Configuration service (apps/api)
PORT=3001
# Host port 55432 matches docker-compose.yml so it does not take a local Postgres on 5432.
DATABASE_URL=postgres://reactiv:reactiv@localhost:55432/reactiv
API_KEY=change-me-to-a-long-random-secret
LOG_LEVEL=info
# Read by the API seed and the web app. Defaults to "default" when unset.
DEFAULT_CONFIG_ID=default

# Web app (apps/web). These are read only by the Next.js server.
CONFIG_SERVICE_URL=http://localhost:3001
CONFIG_SERVICE_API_KEY=change-me-to-a-long-random-secret
