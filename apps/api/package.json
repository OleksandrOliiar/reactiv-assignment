    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@reactiv/contracts": "workspace:*",
    "@scalar/express-api-reference": "^0.10.30",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
